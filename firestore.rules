rules_version = '2';

// 브라우저에서 Firestore에 바로 읽고 쓰는 것을 모두 막습니다.
// 문제 등록·공개 변경·결과 조회·결과 제출은 앱 서버(Firebase Admin SDK)만 처리하고,
// 서버가 요청마다 교사 로그인과 권한, 공개 여부를 직접 확인합니다.
// 그래서 정답·해설과 다른 학생의 결과는 브라우저에서 꺼내 볼 수 없습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
